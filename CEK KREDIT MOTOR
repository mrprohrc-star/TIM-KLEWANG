            btn.classList.add("active");
            customVoucherInput.value = "";

            const val = btn.getAttribute("data-voucher");
            if (val === "auto") {
                voucherMode = "auto";
            } else {
                voucherMode = "fixed";
                customVoucherValue = parseInt(val) || 0;
            }
            renderAll();
        });
    });

    // Custom Voucher Input Listener
    customVoucherInput.addEventListener("input", (e) => {
        voucherButtons.forEach(b => b.classList.remove("active"));
        voucherMode = "custom";
        const val = parseInt(e.target.value) || 0;
        customVoucherValue = Math.max(0, val);
        renderAll();
    });

    // Discount Button Listener
    discountButtons.forEach(btn => {
        btn.addEventListener("click", () => {
            discountButtons.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            customDiscountInput.value = "";
            currentDiscountPerMonth = parseInt(btn.getAttribute("data-discount")) || 0;
            renderAll();
        });
    });

    // Custom Discount Input Listener
    customDiscountInput.addEventListener("input", (e) => {
        discountButtons.forEach(b => b.classList.remove("active"));
        const val = parseInt(e.target.value) || 0;
        currentDiscountPerMonth = Math.max(0, val);
        renderAll();
    });

    // Copy Simulation Summary
    copySummaryBtn.addEventListener("click", copySimulationText);

    handleMotorChange();
}

function handleMotorChange() {
    const motor = databaseMotor[motorSelect.value];

    // Perbarui label voucher bawaan
    defaultVoucherLabel.textContent = motor.defaultVoucher > 0 ? formatRupiah(motor.defaultVoucher) : "Rp 0 (Normal)";

    // Isi Dropdown DP
    dpSelect.innerHTML = "";
    Object.keys(motor.dpRates).forEach(dp => {
        const opt = document.createElement("option");
        opt.value = dp;
        opt.textContent = `${formatRupiah(dp)} (DP Brosur)`;
        dpSelect.appendChild(opt);
    });

    // Isi Dropdown Tenor
    tenorSelect.innerHTML = "";
    motor.tenors.forEach(t => {
        const opt = document.createElement("option");
        opt.value = t.months;
        opt.textContent = `${t.label} (Cukup Bayar ${t.pay}x)`;
        tenorSelect.appendChild(opt);
    });

    renderAll();
}

function getActiveVoucher(motor) {
    if (voucherMode === "auto") {
        return motor.defaultVoucher;
    }
    return customVoucherValue;
}

function renderAll() {
    const motor = databaseMotor[motorSelect.value];
    const dpNormal = parseInt(dpSelect.value) || parseInt(Object.keys(motor.dpRates)[0]);
    const selectedMonths = parseInt(tenorSelect.value) || motor.tenors[0].months;
    const activeTenorObj = motor.tenors.find(t => t.months === selectedMonths) || motor.tenors[0];

    // Hitung Voucher DP & DP Bersih
    const appliedVoucher = getActiveVoucher(motor);
    const dpBayarReal = Math.max(0, dpNormal - appliedVoucher);

    // Hitung Angsuran & Diskon Angsuran
    const installmentNormal = motor.dpRates[dpNormal]?.[selectedMonths] || 0;
    const installmentFinal = Math.max(0, installmentNormal - currentDiscountPerMonth);

    // Hitung Total Penghematan Konsumen (Voucher DP + Seluruh Bulan Diskon Cicilan)
    const totalDiskonCicilan = currentDiscountPerMonth * activeTenorObj.pay;
    const totalPenghematanSemua = appliedVoucher + totalDiskonCicilan;

    // Update Status Tag
    activeVoucherTag.textContent = appliedVoucher > 0 ? `Voucher: -${formatRupiah(appliedVoucher)}` : "Tanpa Voucher";
    activeDiscountTag.textContent = currentDiscountPerMonth > 0 ? `Diskon: -${formatRupiah(currentDiscountPerMonth)} / bln` : "Rp 0 / bln";

    // Update Rincian Kolom Kanan
    document.getElementById("resMotorName").textContent = motor.name;
    document.getElementById("resOtr").textContent = formatRupiah(motor.otr);
    document.getElementById("resDpNormal").textContent = formatRupiah(dpNormal);
    document.getElementById("resVoucherApplied").textContent = appliedVoucher > 0 ? `-${formatRupiah(appliedVoucher)}` : "Rp 0";
    document.getElementById("resDpBayar").textContent = formatRupiah(dpBayarReal);
    document.getElementById("resPotongan").textContent = activeTenorObj.cut > 0 ? `${activeTenorObj.cut} Bulan` : "Tidak Ada";
    document.getElementById("resTenorText").textContent = `${activeTenorObj.pay}x Pembayaran`;
    document.getElementById("resBonusText").textContent = motor.bonus;

    // Angsuran Bersih
    document.getElementById("resAngsuranFinal").textContent = formatRupiah(installmentFinal);
    const originalBadge = document.getElementById("resOriginalBadge");
    if (currentDiscountPerMonth > 0) {
        originalBadge.classList.remove("hidden");
        document.getElementById("resAngsuranNormal").textContent = formatRupiah(installmentNormal);
    } else {
        originalBadge.classList.add("hidden");
    }

    // Total Hemat Banner
    document.getElementById("resTotalHematSemua").textContent = formatRupiah(totalPenghematanSemua);

    // Update Label Tabel
    document.getElementById("tableDpLabel").textContent = formatRupiah(dpBayarReal);
    document.getElementById("tableDiscLabel").textContent = currentDiscountPerMonth > 0 ? `-${formatRupiah(currentDiscountPerMonth)}/bln` : "Rp 0";

    // Render Tabel Perbandingan Semua Tenor
    tenorTableBody.innerHTML = "";
    motor.tenors.forEach(t => {
        const normalRate = motor.dpRates[dpNormal]?.[t.months] || 0;
        const finalRate = Math.max(0, normalRate - currentDiscountPerMonth);
        const isSelected = t.months === selectedMonths;

        const tr = document.createElement("tr");
        tr.className = isSelected ? "bg-red-950/50 font-bold text-white border-l-4 border-red-500" : "hover:bg-slate-800/40 transition-colors";

        tr.innerHTML = `
            <td class="py-2.5 px-3 flex items-center gap-1.5">
                ${isSelected ? '<span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-ping"></span>' : ''}
                <span class="${isSelected ? 'text-red-400 font-extrabold' : ''}">${t.months} Bln</span>
            </td>
            <td class="py-2.5 px-2 text-center">
                ${t.cut > 0 ? `<span class="bg-blue-950/80 text-blue-300 border border-blue-500/40 text-[10px] px-1.5 py-0.5 rounded font-semibold">-${t.cut} Bln</span>` : '<span class="text-slate-600 text-xs">-</span>'}
            </td>
            <td class="py-2.5 px-2 text-center font-semibold text-slate-300">
                ${t.pay}x
            </td>
            <td class="py-2.5 px-2.5 text-right font-medium text-slate-400 text-xs">
                ${currentDiscountPerMonth > 0 ? `<del>${formatRupiah(normalRate)}</del>` : formatRupiah(normalRate)}
            </td>
            <td class="py-2.5 px-3 text-right font-black ${isSelected ? 'text-red-400 text-sm' : 'text-slate-100'}">
                ${formatRupiah(finalRate)}
            </td>
        `;
        tenorTableBody.appendChild(tr);
    });
}

// Copy Summary Generator
function copySimulationText() {
    const motor = databaseMotor[motorSelect.value];
    const dpNormal = parseInt(dpSelect.value) || parseInt(Object.keys(motor.dpRates)[0]);
    const selectedMonths = parseInt(tenorSelect.value) || motor.tenors[0].months;
    const activeTenorObj = motor.tenors.find(t => t.months === selectedMonths) || motor.tenors[0];

    const appliedVoucher = getActiveVoucher(motor);
    const dpBayarReal = Math.max(0, dpNormal - appliedVoucher);
    const installmentNormal = motor.dpRates[dpNormal]?.[selectedMonths] || 0;
    const installmentFinal = Math.max(0, installmentNormal - currentDiscountPerMonth);
    const totalPenghematan = appliedVoucher + (currentDiscountPerMonth * activeTenorObj.pay);

    const summaryText = 
`*SIMULASI KREDIT RESMI HONDA*
*TIM KLEWANG - MPM MOTOR BATAM*
